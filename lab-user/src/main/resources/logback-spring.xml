<?xml version="1.0" encoding="UTF-8"?>
<!-- 阶段1：日志落盘（ELK 演进第一步）——控制台照打，同时写文件、按天+大小滚动、留 7 天。
     统一落项目根 logs/<服务名>/（绝对路径不随启动工作目录漂移；后续 Logstash 只挂载项目根 logs/ 一个目录即可采集全部服务） -->
<configuration>
    <property name="LOG_HOME" value="D:/Code/spring-cloud-lab/logs/lab-user"/>

    <!-- 控制台：开发期照常看（IDEA 控制台）。阶段6：MDC 里的 traceId/orderId 直接进 pattern，
         控制台肉眼可对号（文件侧 JSON 无需改：LogstashEncoder 默认把 MDC 输出为顶层字段） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [trace=%X{traceId:-}] [order=%X{orderId:-}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件：按天 + 50MB 双条件滚动，保留 7 天 / 总量 1GB 上限 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <!-- 阶段2：文件输出 JSON 化 —— 每行一个 JSON 对象（@timestamp/message/level/logger_name/thread_name），
             customFields 附带服务名；后续 Logstash/Kibana 按字段过滤检索全靠它。
             控制台保持人类可读 pattern：机器读文件、人看控制台 -->
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"lab-user"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
