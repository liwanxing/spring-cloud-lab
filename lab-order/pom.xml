<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.liwx</groupId>
        <artifactId>spring-cloud-lab</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>lab-order</artifactId>
    <name>lab-order</name>
    <description>订单服务模块</description>
    <dependencies>
        <dependency><groupId>com.liwx</groupId><artifactId>lab-common</artifactId><version>0.0.1-SNAPSHOT</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>
        <!-- Seata AT 分布式事务（版本走 SCA BOM，与服务端 2.0.0 同版）-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-seata</artifactId>
        </dependency>
        <!-- RocketMQ：延迟消息关单（生产者发延迟消息，消费者到点关单，XXL-Job 退为兜底）
             注：SCA BOM 未管理此件，需显式定版；2.3.1 是断档版（自带 client 5.1.4 却调 5.2.0 的 API，
             启动即 NoSuchMethodError），2.3.2 修复并配 client 5.3 系，与 broker 5.3.1 同代 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.2</version>
        </dependency>
        <!-- Sentinel 限流熔断（版本走 SCA BOM）：URL 资源限流 + Feign 调用降级 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
        <!-- Sentinel 规则持久化：从 Nacos 拉取规则并监听变更（正本在 Nacos，dashboard 降为观察窗） -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
        </dependency>
    </dependencies>
    <build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build>
</project>