# 本地密钥配置模板：复制本文件为 application-local.yml 并填入真实值
# application-local.yml 已被 .gitignore 排除，不会提交到版本库
#
# 密钥来源（沙箱）：支付宝开放平台 -> 控制台 -> 沙箱环境 -> 接口加签方式(公钥模式) -> 查看密钥
# 切换支付渠道：application.yaml 中 payment.channel 可选 alipay / mock（默认 mock）
payment:
  alipay:
    app-id: 沙箱APPID
    merchant-private-key: 应用私钥
    alipay-public-key: 支付宝公钥
